# Copy to .env and fill in values.
# .env is NOT versioned — never commit it.
# Verify: git check-ignore -v .env
# Bank credentials are NOT stored here — configure them in the UI after unlock.

# Host user for the dev container (file ownership on the mounted volume)
USER_ID=1000
GROUP_ID=1000

# PostgreSQL credentials (shared by both stacks; each stack has its own volume)
POSTGRES_USER=finsight
# Development-only default. Use a long random value for any shared deployment.
POSTGRES_PASSWORD=finsight_change_me
POSTGRES_DB=finsight

# --- Host ports (only the web frontends are published) ---
DEV_FRONTEND_PORT=5173
PROD_FRONTEND_PORT=80

# Backend (service hostname "postgres" works inside each compose network)
# Leave unset to derive the URL from POSTGRES_USER, POSTGRES_PASSWORD and POSTGRES_DB.
# DATABASE_URL=
API_HOST=0.0.0.0
API_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost
VAULT_IDLE_TIMEOUT_MINUTES=60

# Required for Volksbank and other German-bank FinTS connections. Register your
# own application product ID at fints.org; finsight does not yet ship a shared
# product ID. Do not commit the real value. Leave empty only if FinTS is unused.
FINTS_PRODUCT_ID=
# Internal Docker service URL. The default is correct for Docker Compose.
FINTS_GATEWAY_URL=http://fints-gateway:8082

# Re-fetch this many days during incremental transaction syncs. The overlap
# catches late or corrected bank bookings; existing transactions are upserted.
SYNC_OVERLAP_DAYS=14

# Local Ollama (LLM categorization after rules).
# From Docker use host.docker.internal so the container reaches host Ollama.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Initial onboarding defaults; later selections are stored in the vault.
OLLAMA_MODEL=gemma4:26b-mlx
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
# Initial value for automatic merchant research during categorization. The
# encrypted preference can be changed later under Settings.
CATEGORIZATION_WEB_SEARCH_ENABLED=true
# Context used by Ollama. The chat summarizes older turns at roughly 70%.
OLLAMA_CONTEXT_WINDOW=32768
# Maximum generated answer tokens for the chat agent.
OLLAMA_OUTPUT_TOKENS=8192
# Optional local diagnostics for categorization (disabled by default).
# DEBUG_LLM=true

# Frontend API base URL for the DEV Vite process.
# Leave empty to use same-origin /api through Vite (works from other LAN devices).
VITE_API_URL=

# Prod frontend build: leave empty so the browser uses same-origin /api via nginx
PROD_VITE_API_URL=
